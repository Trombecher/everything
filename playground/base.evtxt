(@SuccessorOf, @Axiom, _ => $v => exists ($v, @IsInteger, _))
(@SuccessorOf, @Cardinality, $n => $c == 1)

(@IsInteger, @Computed, $o => $o == @Zero or exists ($o, @SuccessorOf, _))

(@Tag, @Computed, $o => exists ($o, @Computed, _) or exists ($o, @Axiom, _))

(@Axiom, @Axiom, $tag => $f => not exists ($tag, @Computed, _) and exists ($f, @Node, _))
(@Axiom, @Cardinality, $n => $n == 1)

(@Cardinality, @Axiom, $o => _ => exists (o, @Axiom, _)])
(@Cardinality, @Cardinality, $n => $n == 1)

(@Computed, @Axiom, $tag => $f => not exists ($tag, @Axiom, _) and exists ($f, @Node, _))
(@Computed, @Cardinality, $n => $n == 1)

(@Node, @Computed, $o =>
    exists ($o, @Node.Function, _)
    xor exists ($o, @Node.Literal, _)
    xor exists ($o, @Node.And, _)
    xor exists ($o, @Node.Xor, _)
    xor exists ($o, @Node.Or, _)
    xor exists ($o, @Node.Not, _)
    xor exists ($o, @Node.Equals, _)
    xor exists ($o, @Node.Exists, _)
)

(@Node.Function, @Axiom, $o => $v => exists ($o, @Node, _) and exists ($v, @Node, _))
(@Node.Function, @Cardinality, $n => $n == 1)

(@Node.Literal, @Axiom, $o => _ => exists ($o, @Node, _))
(@Node.Literal, @Cardinality, $o => $o == 1)

(@Node.Xor, @Axiom, $o => $v => exists ($o, @Node, _) and exists ($v, @Node, _))
(@Node.Xor, @Cardinality, $o => $o > 1)

(@Node.Or, @Axiom, $o => $v => exists ($o, @Node, _) and exists ($v, @Node, _))
(@Node.Or, @Cardinality, $o => $o > 1)

(@Node.And, @Axiom, $o => $v => exists ($o, @Node, _) and exists ($v, @Node, _))
(@Node.And, @Cardinality, $o => $o > 1)

(@Node.Equals, @Axiom, $o => $v => exists ($o, @Node, _) and exists ($v, @Node, _))
(@Node.Equals, @Cardinality, $n => $n > 1)

(@Node.Exists, @Computed, $o =>
    (exists ($o, @Node.Exists.Target, _)
    or exists ($o, @Node.Exists.Tag, _)
    or exists ($o, @Node.Exists.Value, _))
    and exists ($o, @Node, _)
)

(@Node.Exists.Target, @Axiom, $o => $v => exists ($o, @Node.Exists, _) and exists ($v, @Node, _))
(@Node.Exists.Target, @Cardinality, $n => $n == 1)

(@Node.Exists.Tag, @Axiom, $o => $v => exists ($o, @Node.Exists, _) and exists ($v, @Node, _))
(@Node.Exists.Tag, @Cardinality, $n => $n == 1)

(@Node.Exists.Value, @Axiom, $o => $v => exists ($o, @Node.Exists, _) and exists ($v, @Node, _))
(@Node.Exists.Value, @Cardinality, $n => $n == 1)

(@Node.Not, @Axiom, $o => $v => exists ($o, @Node, _) and exists ($v, @Node, _))
(@Node.Not, @Cardinality, $n => $n == 1)