{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Everything",
    "version": "0.1.0",
    "identifier": "app.everything",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Everything",
                "width": 800,
                "height": 600
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon-32.png",
            "icons/icon-64.png",
            "icons/icon-128.png",
            "icons/icon-256.png",
            "icons/icon.ico"
        ]
    }
}
