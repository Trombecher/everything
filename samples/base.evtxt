(@Contains, @Axiom, _ => _ => {(@Contains, {})})

(@SuccessorOf, @Axiom, $o => $v =>
    exists ($v, @IsInteger, _)
    and count query ($o, @SuccessorOf, _) == 1
)

(@IsInteger, @Computed, $o =>
    $o == @Zero
    or exists ($o, @SuccessorOf, _)
)

(@Tag, @Computed, $o =>
    exists ($o, @Computed, _)
    or exists ($o, @Axiom, _)
)

(@Axiom, @Axiom, $tag => $f =>
    not exists ($tag, @Computed, _)
    and exists (
        query $g in ($f, @Node.Function, $g),
        @Node.Function,
        _
    )
    and count query ($tag, @Axiom, _) == 1
)

(@Computed, @Axiom, $tag => $f =>
    not exists ($tag, @Axiom, _)
    and exists ($f, @Node.Function, _)
    and count query ($tag, @Axiom, _) == 1
)

(@Node, @Computed, $o =>
    exists ($o, @Node.Function, _)
    xor exists ($o, @Node.Literal, _)
    xor exists ($o, @Node.And, _)
    xor exists ($o, @Node.Xor, _)
    xor exists ($o, @Node.Or, _)
    xor exists ($o, @Node.Not, _)
    xor exists ($o, @Node.Equals, _)
    xor exists ($o, @Node.Exists, _)
    xor exists ($o, @Node.Query, _)
)

(@Node.Function, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Function, _) == 1
)

(@Node.Literal, @Axiom, $o => _ =>
    count query ($o, @Node.Literal, _) == 1
)

(@Node.Xor, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Xor, _) > 1
)

(@Node.Or, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Or, _) > 1
)

(@Node.And, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.And, _) > 1
)

(@Node.Equals, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Equals, _) > 1
)

(@Node.Exists, @Computed, $o =>
    count (exists ($o, @Node.Exists.Target, _)
    + count exists ($o, @Node.Exists.Tag, _)
    + count exists ($o, @Node.Exists.Value, _) > 0)
)

(@Node.Exists.Target, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, Node.Exists.Target, _) == 1
)

(@Node.Exists.Tag, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Exists.Tag, _) == 1
)

(@Node.Exists.Value, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Exists.Value, _) == 1
)

(@Node.Not, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Not, _) == 1
)

(@Node.Count, @Axiom, $o => $v =>
    exists ($v, @Node, _)
    and count query ($o, @Node.Count, _) == 1
)

(Node.Query, @Computed, $o =>
    exists ($o, @Node, )
)